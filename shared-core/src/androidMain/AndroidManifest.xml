<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The bundled mpv payload declares minSdk 26; AndroidMpvRuntimeAvailability
         refuses mpv construction below API 26 so consumers can run on 25. -->
    <uses-sdk tools:overrideLibrary="dev.jdtech.mpv" />

    <!-- API 34+ user-initiated data-transfer jobs.  The scheduler selects this
         path exclusively on API 34 and newer; it never falls back to the
         WorkManager path when UIDT admission is rejected. -->
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />

    <!-- API 33 and lower WorkManager foreground dataSync path. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- The host posts one visible progress/cancel notification.  Runtime
         notification permission remains an app concern on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="com.jellyscope.core.download.AndroidDownloadJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:foregroundServiceType="dataSync"
            tools:targetApi="34" />
        <receiver
            android:name="com.jellyscope.core.download.AndroidDownloadCancelReceiver"
            android:exported="false" />
    </application>

</manifest>
